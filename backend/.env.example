# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file — it is gitignored.

# Port the server listens on (Render sets this automatically)
PORT=3000

# Secret used to sign JWT tokens — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string

# How long login tokens stay valid
JWT_EXPIRES_IN=7d

# PostgreSQL connection string (Render provides this as an external database URL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Display name used in emails/UI
APP_NAME=Carbon Footprint

# ---- Email verification (Gmail SMTP via nodemailer) ----
# Gmail address that sends verification codes
GMAIL_USER=you@gmail.com

# 16-char Gmail App Password (Google Account -> Security -> 2-Step Verification -> App passwords)
# If GMAIL_USER / GMAIL_APP_PASSWORD are unset, the server prints verification
# codes to the logs instead of emailing them (DEV MODE fallback).
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Optional: "From" name/email shown in outgoing mail (defaults to GMAIL_USER)
EMAIL_FROM="Carbon Footprint <you@gmail.com>"

# How many minutes a verification code stays valid
VERIFICATION_CODE_EXP_MIN=10
